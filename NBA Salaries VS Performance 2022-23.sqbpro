ndex="16" value="43"/><column index="17" value="42"/><column index="18" value="43"/><column index="19" value="46"/><column index="20" value="45"/><column index="21" value="39"/><column index="22" value="39"/><column index="23" value="39"/><column index="24" value="54"/><column index="25" value="46"/><column index="26" value="46"/><column index="27" value="46"/><column index="28" value="40"/><column index="29" value="187"/><column index="30" value="103"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">ALTER TABLE salaries RENAME COLUMN &quot;player name&quot; TO player;
SELECT s.Player, s.Pos, s.Age, s.MP, s.WS, s.VORP,
       CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) AS salary,
       ROUND(s.VORP / (CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS REAL) / 1000000), 3) AS VORP_per_million
FROM stats s
JOIN salaries sal ON s.Player = sal.&quot;player&quot;
WHERE s.MP &gt;= 1000
ORDER BY VORP_per_million DESC
LIMIT 10;
SELECT s.Player, s.Pos, s.Age, s.MP, s.WS, s.VORP,
       CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) AS salary,
       ROUND(s.ws / (CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS REAL) / 1000000), 3) AS ws_per_million
FROM stats s
JOIN salaries sal ON s.Player = sal.&quot;player&quot;
WHERE s.MP &gt;= 1000
ORDER BY ws_per_million DESC
LIMIT 10;
SELECT s.Player, s.Pos, s.Age, s.MP, s.WS, s.VORP,
       CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) AS salary,
       ROUND(s.ws / (CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS REAL) / 1000000), 3) AS ws_per_million
FROM stats s
JOIN salaries sal ON s.Player = sal.&quot;player&quot;
WHERE s.MP &gt;= 1000
  AND CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) &gt;= 20000000
ORDER BY ws_per_million DESC
LIMIT 10;
SELECT s.Player, s.Pos, s.Age, s.MP, s.WS, s.VORP,
       CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) AS salary,
       ROUND(s.VORP / (CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS REAL) / 1000000), 3) AS VORP_per_million
FROM stats s
JOIN salaries sal ON s.Player = sal.&quot;player&quot;
WHERE s.MP &gt;= 1000
  AND CAST(REPLACE(REPLACE(sal.salary,'$',''),',','') AS INTEGER) &gt;= 20000000
ORDER BY VORP_per_million DESC
LIMIT 10;</sql><current_tab id="0"/></tab_sql></sqlb_project>
